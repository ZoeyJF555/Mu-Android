<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-android</TargetFramework>
    <RootNamespace>Mu.Client.Android</RootNamespace>
    <AssemblyName>MuClient.Android</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>com.muandroid.client</ApplicationId>
    <ApplicationTitle>Mu Android</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MuCore\MuCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\MuClient.Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
