<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-android</TargetFramework>
    <RootNamespace>Mu.Client.Android</RootNamespace>
    <AssemblyName>MuClient.Android</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>com.muandroid.client</ApplicationId>
    <ApplicationTitle>Mu Android</ApplicationTitle>
    <ApplicationVersion>3</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.2</ApplicationDisplayVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MuCore\MuCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\MuClient.Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Los datos del cliente no están en el repositorio porque tienen copyright, así
    que el APK se puede compilar sin ellos. Para que el juego funcione en el
    móvil hay que empaquetarlos indicando su carpeta:

      dotnet build src/MuClient.Android/MuClient.Android.csproj -c Release \
        -p:MuDataFolder=/ruta/a/Data

    Sin esa propiedad el APK se construye igual, pero el juego avisa de que le
    faltan los datos en vez de quedarse en negro.
  -->
  <ItemGroup Condition="'$(MuDataFolder)' != ''">
    <AndroidAsset Include="$(MuDataFolder)\**\*" Link="Data\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="ComprobarCarpetaDeDatos" BeforeTargets="Build" Condition="'$(MuDataFolder)' != '' and !Exists('$(MuDataFolder)')">
    <Error Text="La carpeta de datos '$(MuDataFolder)' no existe." />
  </Target>

</Project>
